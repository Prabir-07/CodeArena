# Base URL of the User Service API.
#
# Leave unset for local development: Vite's dev proxy (see vite.config.js)
# forwards same-origin /auth, /users, and /sessions requests to the User
# Service running on http://localhost:5000, so no value is needed here.
#
# Set this explicitly to point the built app at a different User Service,
# e.g. a deployed environment:
# VITE_USER_SERVICE_URL=https://api.example.com
VITE_USER_SERVICE_URL=
