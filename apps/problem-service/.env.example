PORT=5001
NODE_ENV=development

# Points at the postgres-problems container already defined in the repo
# root's docker-compose.yml (problems_db on host port 5433) — a separate
# database from the User Service's postgres-users (port 5432).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/problems_db?schema=public"

# Must match the User Service's JWT_ACCESS_SECRET exactly. This service
# verifies the same access tokens User Service issues, independently — it
# never issues, refreshes, or calls back to User Service for them.
JWT_ACCESS_SECRET=changeme_access_secret
