PORT=5001
NODE_ENV=development

# Points at the postgres-problems container already defined in the repo
# root's docker-compose.yml (problems_db on host port 5433). Not yet used by
# any code in this milestone — the Prisma schema and client are introduced
# in M2. Defined here now so the service's environment contract is complete
# and consistent with the User Service's .env.example.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/problems_db?schema=public"
